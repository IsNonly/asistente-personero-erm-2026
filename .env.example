# ==========================================================
# ASISTENTE DEL PERSONERO — ERM 2026
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a un repositorio.
# ==========================================================

# ---------- Servidor (backend Express) ----------
PORT=4000
NODE_ENV=development

# ---------- Inteligencia Artificial (Claude / Anthropic) ----------
# Si esta clave está vacía, el asistente responde:
# "Servicio de IA pendiente de configuración."
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Base de datos PostgreSQL ----------
# Si esta variable está vacía, el servidor funciona sin BD
# (las incidencias se guardan solo en el navegador).
DATABASE_URL=postgresql://usuario:password@localhost:5432/asistente_personero

# ---------- Cliente (Vite) ----------
# El cliente lee esta variable desde client/.env
# Déjala como /api para usar el proxy de desarrollo.
VITE_API_URL=/api

# Clave para ver la lista de registrados: GET /api/registros con la cabecera
# x-admin-token (o ?token=...). Vacío = la lista no se puede consultar.
ADMIN_TOKEN=

# Supabase (registro de personeros). Tiene prioridad sobre DATABASE_URL.
# Usa la service_role key SOLO aquí (servidor); nunca en el cliente ni en Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
