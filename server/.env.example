# Servidor
PORT=4000
NODE_ENV=development

# IA (Claude / Anthropic) — vacío = "Servicio de IA pendiente de configuración."
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# PostgreSQL — vacío = modo local sin base de datos
DATABASE_URL=

# Clave para ver la lista de registrados: GET /api/registros con la cabecera
# x-admin-token (o ?token=...). Vacío = la lista no se puede consultar.
ADMIN_TOKEN=
